# Copy this file to .env and fill in ALL values before running the server.
# Never commit the real .env file.

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT signing secret — generate with: node -e "console.log(require(''crypto'').randomBytes(64).toString(''hex''))"
JWT_SECRET=

# AES-256-CBC encryption key — must be exactly 32 characters
ENCRYPTION_KEY=

# Frontend origin for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# Gmail App Password for Nodemailer (NOT your account password)
EMAIL_USER=
EMAIL_PASS=

# Seed script credentials (only needed when running seedAdmin.ts)
SEED_ADMIN_EMAIL=admin@timecapsule.com
SEED_ADMIN_PASSWORD=

# Google Cloud Storage
GCS_BUCKET_NAME=time-capsule-files
# For local dev only — point to your downloaded service account key JSON.
# On Cloud Run, leave this unset; GCS authenticates via the instance service account.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
